        "ActionParameters": [
          {
            "Id": 2430,
            "GlobalId": "00000000-0000-0000-0000-000000000000",
            "ActionId": 543,
            "Name": "ScriptName",
            "Value": "flat_to_nested",
            "ActionStackId": null,
            "ParentParameterId": null,
            "IsExpression": false,
            "OrderIndex": 0,
            "LastModified": "0001-01-01T00:00:00+00:00",
            "LastModifiedBy": null
          },
          {
            "Id": 2431,
            "GlobalId": "00000000-0000-0000-0000-000000000000",
            "ActionId": 543,
            "Name": "Code",
            "Value": "function unflattenObject(obj) {\r\n  const result = {};\r\n\r\n  for (const key in obj) {\r\n    const keys = key.split(\".\");\r\n    let current = result;\r\n\r\n    for (let i = 0; i < keys.length; i++) {\r\n      const part = keys[i];\r\n\r\n      if (i === keys.length - 1) {\r\n        current[part] = obj[key];\r\n      } else {\r\n        current[part] = current[part] || {};\r\n        current = current[part];\r\n      }\r\n    }\r\n  }\r\n\r\n  return result;\r\n}\r\n\r\nconst parsed = JSON.parse(AlertsJSONString);\r\nconst nested = parsed.map(item => unflattenObject(item));\r\nreturn JSON.stringify(nested);",
            "ActionStackId": null,
            "ParentParameterId": null,
            "IsExpression": false,
            "OrderIndex": 0,
            "LastModified": "0001-01-01T00:00:00+00:00",
            "LastModifiedBy": null
          },
