          {
            "Id": 2441,
            "GlobalId": "00000000-0000-0000-0000-000000000000",
            "ActionId": 544,
            "Name": "SqlQuery",
            "Value": "DECLARE @NewAlertData TABLE (\r\n    ActionType NVARCHAR(10),\r\n    AlertId INT,\r\n    ResourceId NVARCHAR(450),\r\n    SeverityId INT,\r\n    Properties NVARCHAR(MAX)\r\n);\r\n;WITH WorkflowAlerts as (\r\n    SELECT distinct\r\n        a.resourceId,\r\n        a.severity,\r\n        a.Details,\r\n        a.ResourceURL,\r\n        a.Instructions,\r\n        a.title,\r\n        s.id as severityid,\r\n        a.properties\r\n    FROM OPENJSON(@AlertsJson)\r\n    WITH (\r\n        resourceId nvarchar(450) '$.resourceId',\r\n        Title nvarchar(450) '$.Title',\r\n        Details nvarchar(450) '$.Details',\r\n        severity   VARCHAR(20) '$.severity',\r\n        ResourceURL nvarchar(450) '$.ResourceURL',\r\n        Instructions nvarchar(max) '$.Instructions',\r\n        properties NVARCHAR(MAX) AS JSON\r\n    ) a\r\n    INNER JOIN paa.AlertSeverity s ON s.name = a.severity\r\n)\r\n\r\nMERGE paa.Alert AS A\r\nUSING WorkflowAlerts AS WA on A.resourceId = WA.resourceId AND A.Type = @AlertType and A.Status = 1\r\nWHEN MATCHED THEN\r\n    UPDATE SET\r\n        A.Severity = iif(A.Severity = 4, A.Severity, WA.severityId),\r\n        A.Title = wa.title,\r\n        A.Details = WA.Details,\r\n        A.ResourceURL = wa.ResourceURL,\r\n        A.Instructions = wa.Instructions\r\nWHEN NOT MATCHED BY TARGET THEN\r\n    INSERT (ResourceId, severity, Type, CreatedDate, Status, Title, Details, ResourceURL, Instructions)\r\n   VALUES (WA.resourceId, wa.severityId, @AlertType, SYSDATETIMEOFFSET(), 1, wa.title, wa.Details, WA.ResourceURL, wa.Instructions)\r\n\r\nWHEN NOT MATCHED BY SOURCE AND A.Type = @AlertType THEN \r\nUPDATE SET A.Status = 2, A.ClosedDate = SYSDATETIMEOFFSET()\r\n\r\nOUTPUT $action, inserted.Id, inserted.ResourceId, inserted.Severity, WA.Properties\r\nINTO @NewAlertData\r\n(ActionType, AlertId, ResourceId, SeverityId, Properties);\r\n\r\nDELETE ap FROM paa.AlertData ap\r\nINNER JOIN @NewAlertData nap ON nap.AlertId = ap.AlertId\r\nWHERE nap.ActionType = 'UPDATE';\r\n\r\nINSERT INTO paa.AlertData (AlertId, [Key], [Value])\r\nSELECT nap.AlertId, j.[key], j.[value] FROM @NewAlertData nap\r\nCROSS APPLY OPENJSON(nap.Properties) j\r\nWHERE nap.Properties IS NOT NULL",
            "ActionStackId": null,
            "ParentParameterId": null,
            "IsExpression": false,
            "OrderIndex": 0,
            "LastModified": "0001-01-01T00:00:00+00:00",
