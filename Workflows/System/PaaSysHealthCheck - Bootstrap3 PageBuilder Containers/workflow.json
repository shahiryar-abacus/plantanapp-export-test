          },
          {
            "Id": 2506,
            "GlobalId": "00000000-0000-0000-0000-000000000000",
            "ActionId": 552,
            "Name": "SqlQuery",
            "Value": "SELECT\r\n(\r\n    SELECT\r\n        t.TabID AS resourceId,\r\n        'Medium' AS severity,\r\n        JSON_QUERY\r\n        (\r\n            (\r\n                SELECT\r\n                    t.TabID AS PageNumber,\r\n                    t.TabName AS PageName,\r\n                    t.TabPath,\r\n                    t.PortalID AS PortalId,\r\n                    pl.PortalName,\r\n                    'true' AS paa_preventMajorUpgrades,\r\n                    t.SkinSrc\r\n                FOR JSON PATH, WITHOUT_ARRAY_WRAPPER\r\n            )\r\n        ) AS properties\r\n    FROM {databaseOwner}[{objectQualifier}Tabs] t\r\n    OUTER APPLY\r\n    (\r\n        SELECT TOP (1)\r\n            pl.PortalName\r\n        FROM {databaseOwner}[{objectQualifier}PortalLocalization] pl\r\n        WHERE pl.PortalID = t.PortalID\r\n        ORDER BY\r\n            CASE WHEN pl.CultureCode = 'en-US' THEN 0 ELSE 1 END,\r\n            pl.CultureCode\r\n    ) pl\r\n    WHERE\r\n        t.IsDeleted = 0\r\n        AND t.SkinSrc IS NOT NULL\r\n        AND\r\n        (\r\n            t.SkinSrc LIKE '%pagebuilder/Default.ascx%'\r\n            OR t.SkinSrc LIKE '%pagebuilder/ForgotPassword_No_Menu.ascx%'\r\n            OR t.SkinSrc LIKE '%pagebuilder/Login_No_Menu.ascx%'\r\n            OR t.SkinSrc LIKE '%pagebuilder/Reset_Password_No_Menu.ascx%'\r\n        )\r\n    FOR JSON PATH\r\n) AS PAASysAlerts;",
            "ActionStackId": null,
            "ParentParameterId": null,
            "IsExpression": false,
            "OrderIndex": 0,
            "LastModified": "0001-01-01T00:00:00+00:00",
            "LastModifiedBy": null
