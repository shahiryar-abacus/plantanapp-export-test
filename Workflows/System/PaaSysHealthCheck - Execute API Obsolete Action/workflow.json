            "ActionId": 558,
            "Name": "SqlQuery",
            "Value": "WITH ActionsCTE AS\r\n(\r\n    SELECT\r\n        a.Id AS resourceId,\r\n        'Medium' AS severity,\r\n        JSON_QUERY\r\n        (\r\n            (\r\n                SELECT\r\n                    a.Id AS ActionId,\r\n                    a.Description,\r\n                    a.ActionType,\r\n                    'true' AS paa_preventMajorUpgrades\r\n                FOR JSON PATH, WITHOUT_ARRAY_WRAPPER\r\n            )\r\n        ) AS properties\r\n    FROM paa.Actions a\r\n    WHERE a.ActionType = 'ExecuteApiMethod'\r\n)\r\nSELECT\r\n(\r\n    SELECT\r\n        resourceId,\r\n        severity,\r\n        JSON_QUERY(properties) AS properties\r\n    FROM ActionsCTE\r\n    FOR JSON PATH\r\n) AS PAASysAlerts;",
