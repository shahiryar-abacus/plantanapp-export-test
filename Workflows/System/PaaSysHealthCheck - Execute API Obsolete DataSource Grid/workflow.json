          {
            "Id": 2571,
            "GlobalId": "00000000-0000-0000-0000-000000000000",
            "ActionId": 560,
            "Name": "SqlQuery",
            "Value": "WITH FieldsCTE AS\r\n(\r\n    SELECT\r\n        f.Id AS resourceId,\r\n        'Medium' AS severity,\r\n        JSON_QUERY\r\n        (\r\n            (\r\n                SELECT\r\n                    t.TabID AS PageNumber,\r\n                    t.TabName AS PageName,\r\n                    tm.ModuleTitle,\r\n                    tm.PaneName,\r\n                    t.PortalID AS PortalId,\r\n                    pl.PortalName,\r\n                    m.ModuleID,\r\n                    f.Id AS FieldId,\r\n                    f.RefName,\r\n                    f.Title AS FieldTitle,\r\n                    ep.Value AS DataSource,\r\n                    'Inline Edit field uses APIMethod as its DataSource.' AS Details,\r\n                    'true' AS paa_preventMajorUpgrades\r\n                FOR JSON PATH, WITHOUT_ARRAY_WRAPPER\r\n            )\r\n        ) AS properties\r\n    FROM {databaseOwner}[{objectQualifier}DnnSharp_ActionGrid_Fields_EditPrm] ep\r\n    INNER JOIN {databaseOwner}[{objectQualifier}DnnSharp_ActionGrid_Fields] f\r\n        ON ep.FieldId = f.Id\r\n    INNER JOIN {databaseOwner}[{objectQualifier}Modules] m\r\n        ON f.ModuleId = m.ModuleID\r\n    INNER JOIN {databaseOwner}[{objectQualifier}TabModules] tm\r\n        ON m.ModuleID = tm.ModuleID\r\n    INNER JOIN {databaseOwner}[{objectQualifier}Tabs] t\r\n        ON tm.TabID = t.TabID\r\n    OUTER APPLY\r\n    (\r\n        SELECT TOP (1)\r\n            pl.PortalName\r\n        FROM {databaseOwner}[{objectQualifier}PortalLocalization] pl\r\n        WHERE pl.PortalID = t.PortalID\r\n        ORDER BY\r\n            CASE WHEN pl.CultureCode = 'en-US' THEN 0 ELSE 1 END,\r\n            pl.CultureCode\r\n    ) pl\r\n    WHERE ep.Name = 'DataSource'\r\n      AND ep.Value = 'APIMethod'\r\n      AND tm.IsDeleted = 0\r\n)\r\nSELECT\r\n(\r\n    SELECT\r\n        resourceId,\r\n        severity,\r\n        JSON_QUERY(properties) AS properties\r\n    FROM FieldsCTE\r\n    FOR JSON PATH\r\n) AS PAASysAlerts;",
            "ActionStackId": null,
            "ParentParameterId": null,
            "IsExpression": false,
            "OrderIndex": 0,
            "LastModified": "0001-01-01T00:00:00+00:00",
