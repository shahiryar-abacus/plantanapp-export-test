            "LastModifiedBy": null
          },
          {
            "Id": 2633,
            "GlobalId": "00000000-0000-0000-0000-000000000000",
            "ActionId": 571,
            "Name": "SqlQuery",
            "Value": "WITH HistoryCTE AS\r\n(\r\n    SELECT\r\n        'DnnSharp_SharpScheduler_History' AS resourceId,\r\n\r\n        COUNT(*) AS RecordCount,\r\n\r\n        MIN(DateStart) AS OldestHistoryDate,\r\n        MAX(DateStart) AS NewestHistoryDate,\r\n\r\n        DATEDIFF(day, MIN(DateStart), GETDATE()) AS OldestHistoryAgeDays,\r\n        DATEDIFF(day, MAX(DateStart), GETDATE()) AS NewestHistoryAgeDays\r\n\r\n    FROM {databaseOwner}[{objectQualifier}DnnSharp_SharpScheduler_History]\r\n)\r\n\r\nSELECT\r\n(\r\n    SELECT\r\n        resourceId,\r\n\r\n        CASE\r\n            WHEN RecordCount > 1000000\r\n              OR OldestHistoryAgeDays > 365\r\n                THEN 'Medium'\r\n\r\n            WHEN RecordCount > 100000\r\n              OR OldestHistoryAgeDays > 90\r\n                THEN 'Warning'\r\n        END AS severity,\r\n\r\n        JSON_QUERY\r\n        (\r\n            (\r\n                SELECT\r\n                    RecordCount,\r\n                    OldestHistoryDate,\r\n                    OldestHistoryAgeDays,\r\n                    NewestHistoryDate,\r\n                    NewestHistoryAgeDays,\r\n                    @ConfigURL AS ConfigURL\r\n\r\n                FOR JSON PATH, WITHOUT_ARRAY_WRAPPER\r\n            )\r\n        ) AS properties\r\n\r\n    FROM HistoryCTE\r\n    WHERE\r\n           RecordCount > 100000\r\n        OR OldestHistoryAgeDays > 90\r\n\r\n    FOR JSON PATH\r\n) AS PAASysAlerts;",
            "ActionStackId": null,
            "ParentParameterId": null,
            "IsExpression": false,
            "OrderIndex": 0,
            "LastModified": "0001-01-01T00:00:00+00:00",
            "LastModifiedBy": null
