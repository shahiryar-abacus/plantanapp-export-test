            "LastModifiedBy": null
          },
          {
            "Id": 2597,
            "GlobalId": "00000000-0000-0000-0000-000000000000",
            "ActionId": 565,
            "Name": "SqlQuery",
            "Value": "WITH FireTriggerQueueCTE AS\r\n(\r\n    SELECT\r\n        t.Id AS resourceId,\r\n\r\n        COUNT(ft.Id) AS PendingEvents,\r\n\r\n        CASE\r\n            WHEN COUNT(ft.Id) > 10000 THEN 'Critical'\r\n            WHEN COUNT(ft.Id) > 1000  THEN 'Medium'\r\n            ELSE 'Warning'\r\n        END AS severity,\r\n\r\nJSON_QUERY\r\n(\r\n    (\r\n        SELECT\r\n            t.Id                AS TriggerId,\r\n            t.TriggerDefId      AS TriggerDefId,\r\n            COUNT(ft.Id)        AS PendingEvents,\r\n\r\n            j.Id                AS JobId,\r\n            j.Name              AS JobName,\r\n            j.IsEnabled         AS JobEnabled,\r\n\r\n            t.IsEnabled         AS TriggerEnabled,\r\n            t.LastModified      AS TriggerLastModified,\r\n\r\n            CASE\r\n                WHEN j.IsEnabled = 0 OR t.IsEnabled = 0 THEN\r\n                    'Hint: There are unprocessed events for this trigger. They will not be processed until both the job and trigger are enabled.'\r\n                ELSE ''\r\n            END AS HintMustEnable,\r\n\r\n            @ConfigURL AS ConfigURL\r\n\r\n\r\n        FOR JSON PATH, WITHOUT_ARRAY_WRAPPER\r\n    )\r\n) AS properties\r\n    FROM {databaseOwner}[{objectQualifier}DnnSharp_SharpScheduler_FireTriggers] ft\r\n    INNER JOIN {databaseOwner}[{objectQualifier}DnnSharp_SharpScheduler_Triggers] t\r\n        ON ft.TriggerId = t.Id\r\n    INNER JOIN {databaseOwner}[{objectQualifier}DnnSharp_SharpScheduler_Jobs] j\r\n        ON t.JobId = j.Id\r\n\r\n    GROUP BY\r\n        t.Id,\r\n        t.TriggerDefId,\r\n        t.IsEnabled,\r\n        t.LastModified,\r\n        j.Id,\r\n        j.Name,\r\n        j.IsEnabled\r\n\r\n    HAVING COUNT(ft.Id) > 99\r\n)\r\n\r\nSELECT\r\n(\r\n    SELECT\r\n        resourceId,\r\n        severity,\r\n        JSON_QUERY(properties) AS properties\r\n    FROM FireTriggerQueueCTE\r\n    ORDER BY PendingEvents DESC\r\n    FOR JSON PATH\r\n) AS PAASysAlerts;",
            "ActionStackId": null,
            "ParentParameterId": null,
            "IsExpression": false,
            "OrderIndex": 0,
            "LastModified": "0001-01-01T00:00:00+00:00",
            "LastModifiedBy": null
